---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl } from "../../lib/seo";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const canonicalPath = "/papers-re-reviewed/";
const pageUrl = absoluteUrl(canonicalPath, Astro.site);

const episodes = [
  {
    number: "03",
    date: "July 2026",
    durationLabel: "108 seconds",
    durationSchema: "PT1M48S",
    paper: "Lin et al. (2019) · Water Resources Research",
    title: "The paper I put in a freezer.",
    synopsis:
      "An inherited aquifer thermal energy storage problem returned years later with a corrected formulation, a Robin-type injection-well boundary, global sensitivity analysis, and a field test in Mobile, Alabama.",
    stillTitle: "The injection-period model earned its place.",
    stillText:
      "The paper joined conduction and dispersion, tested the well boundary against alternative solutions, screened parameter effects with the Morris method, and reproduced the reported injection-period temperature response reasonably well.",
    changeTitle: "An injection solution is not an operating cycle.",
    changeText:
      "The full injection-storage-recovery problem cannot be obtained by casually superposing states governed by different conditions. Today I would treat the terminal state as the next initial condition and design the complete cycle from the outset.",
    verdict: "Accept the injection paper. Write the sequel.",
    video: "/videos/re-reviewed/2019-ates/paper-roast-2019-ates-episode-03.mp4",
    poster: "/videos/re-reviewed/2019-ates/paper-roast-2019-ates-episode-03.jpg",
    captions: "/videos/re-reviewed/2019-ates/paper-roast-2019-ates-episode-03.en.vtt",
    doi: "https://doi.org/10.1029/2019WR024966",
    aria: "A retrospective review of the 2019 aquifer thermal energy storage model",
  },
  {
    number: "02",
    date: "July 2026",
    durationLabel: "85 seconds",
    durationSchema: "PT1M25S",
    paper: "Lin, Li, and Yeh (2017) · Advances in Water Resources",
    title: "The forward problem had a solution.",
    synopsis:
      "A constant-head test became a three-layer saturated-unsaturated mixed-boundary problem, then acquired numerical validation, four field applications, and a five-parameter inverse problem.",
    stillTitle: "The mathematical and numerical checks were substantive.",
    stillText:
      "The analytical solution closely matched FEMWATER, and the four Iowa well records supplied a field-facing test of the forward model. The constant-head formulation also exposed why head and discharge contain different information.",
    changeTitle: "Five fitted numbers were not five identified parameters.",
    changeText:
      "The paper reported point estimates without confidence intervals, parameter-correlation maps, or a formal identifiability test. Today I would use joint head-flow inversion and test whether conductivity, storage, and the unsaturated exponent can actually be separated.",
    verdict: "Keep the mathematics. Reopen the inverse problem.",
    video: "/videos/re-reviewed/2017-constant-head/reviewer-3-2017-constant-head.mp4",
    poster: "/videos/re-reviewed/2017-constant-head/reviewer-3-2017-constant-head.jpg",
    captions: "/videos/re-reviewed/2017-constant-head/reviewer-3-2017-constant-head.en.vtt",
    doi: "https://doi.org/10.1016/j.advwatres.2017.07.023",
    aria: "A retrospective review of the 2017 constant-head saturated-unsaturated aquifer model",
  },
  {
    number: "01",
    date: "July 2026",
    durationLabel: "58 seconds",
    durationSchema: "PT58S",
    paper: "Lin et al. (2016) · Journal of Hydrology",
    title: "A general solution to a very specific aquifer.",
    synopsis:
      "The paper derived an analytical pumping-test model for a radial, finite, two-zone confined aquifer with a Robin-type outer boundary. Ten years later, the derivation is not the part I would challenge.",
    stillTitle: "The analytical contribution was real.",
    stillText:
      "The work produced a general solution within its stated conceptual model and examined how the Robin-type outer boundary, finite radial extent, and two-zone structure affect drawdown and wellbore response.",
    changeTitle: "Solvability is not field readiness.",
    changeText:
      "The concentric outer boundary is difficult to defend for most field settings. The paper did not fit field data, test parameter identifiability, or turn its root-search procedure into a reproducible inversion workflow.",
    verdict: "The mathematics was real. So was the later lesson.",
    video: "/videos/re-reviewed/2016-general-model/reviewer-3-2016.mp4",
    poster: "/videos/re-reviewed/2016-general-model/reviewer-3-2016.webp",
    captions: "/videos/re-reviewed/2016-general-model/reviewer-3-2016.en.vtt",
    doi: "https://doi.org/10.1016/j.jhydrol.2016.07.028",
    aria: "A retrospective review of the 2016 general analytical aquifer model",
  },
];

const schema = {
  "@type": "ItemList",
  "@id": `${pageUrl}#series`,
  name: "My Papers, Re-reviewed",
  itemListElement: episodes.map((episode, index) => ({
    "@type": "VideoObject",
    position: index + 1,
    name: episode.title,
    description: episode.synopsis,
    thumbnailUrl: absoluteUrl(episode.poster, Astro.site),
    contentUrl: absoluteUrl(episode.video, Astro.site),
    uploadDate: "2026-07-25",
    duration: episode.durationSchema,
    author: { "@id": `${absoluteUrl("/", Astro.site)}#person` },
  })),
};
---

<BaseLayout
  title="My Papers, Re-reviewed"
  description="Ying-Fan Lin revisits earlier groundwater papers with the benefit of later evidence, preserving what worked and identifying what he would test differently now."
  canonicalPath={canonicalPath}
  image={episodes[0].poster}
  schema={schema}
  type="article"
  pageClass="papers-rereviewed"
>
  <header class="rereview-hero">
    <div class="rereview-shell">
      <p class="rereview-kicker">A retrospective research series</p>
      <h1>My Papers,<br /><em>Re-reviewed.</em></h1>
      <p class="rereview-deck">
        Published work should survive more than peer review. In this series, I return to my own papers, keep the
        contribution that still holds, and name the questions I did not yet know how to ask.
      </p>
    </div>
  </header>

  <main class="episode">
    {
      episodes.map((episode) => (
        <section class="episode__shell" id={`episode-${episode.number}`}>
          <aside class="episode__index" aria-label={`Episode ${episode.number} information`}>
            <span>{episode.number}</span>
            <p>{episode.date}</p>
            <p>{episode.durationLabel}</p>
            <p>Reviewer #3: Future Me</p>
          </aside>

          <article class="episode__body">
            <header class="episode__heading">
              <p class="rereview-kicker">{episode.paper}</p>
              <h2>{episode.title}</h2>
              <p>{episode.synopsis}</p>
            </header>

            <figure class="episode__film">
              <video
                controls
                playsinline
                preload="metadata"
                poster={withBase(episode.poster)}
                width="1080"
                height="1920"
                aria-label={episode.aria}
              >
                <source src={withBase(episode.video)} type="video/mp4" />
                <track
                  kind="captions"
                  src={withBase(episode.captions)}
                  srclang="en"
                  label="English"
                  default
                />
                Your browser does not support the video element.
              </video>
              <figcaption>
                Paper evidence, author recollection, and retrospective questions are labeled separately in the film.
                Technical claims are bounded by the published article.
              </figcaption>
            </figure>

            <section class="episode__grid" aria-label={`Episode ${episode.number} retrospective review`}>
              <div>
                <p class="rereview-kicker">What still holds</p>
                <h3>{episode.stillTitle}</h3>
                <p>{episode.stillText}</p>
              </div>
              <div>
                <p class="rereview-kicker">What I would change</p>
                <h3>{episode.changeTitle}</h3>
                <p>{episode.changeText}</p>
              </div>
            </section>

            <blockquote>
              <p>“{episode.verdict}”</p>
              <footer>Reviewer #3: Future Me</footer>
            </blockquote>

            <p class="episode__links">
              <a href={episode.doi} target="_blank" rel="noreferrer">Read the published paper</a>
              <a href={withBase("/publications/")}>Browse the publication record</a>
            </p>
          </article>
        </section>
      ))
    }

    <section class="episode__afterword rereview-shell" aria-labelledby="afterword-title">
      <p class="rereview-kicker">Why publish the criticism?</p>
      <h2 id="afterword-title">A research trajectory should show correction, not just accumulation.</h2>
      <p>
        This series is neither a retraction nor a claim that the original derivations were wrong. It records how my
        standard changed: from asking whether a groundwater problem admits an analytical solution to asking whether
        the model can be identified, reproduced, compared with alternatives, and used without hiding consequential
        uncertainty.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .rereview-shell,
  .episode__shell {
    margin: 0 auto;
    max-width: 1160px;
    padding-inline: 1.5rem;
  }

  .rereview-hero {
    background: #f4f0e7;
    border-bottom: 1px solid rgb(var(--text-rgb) / 0.16);
    padding: clamp(5rem, 11vw, 9.5rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .rereview-kicker {
    color: #0f807d;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .rereview-hero h1 {
    color: var(--text);
    font-family: Merriweather, Georgia, serif;
    font-size: clamp(3.8rem, 11vw, 8.7rem);
    letter-spacing: 0;
    line-height: 0.9;
    margin: 0;
  }

  .rereview-hero h1 em {
    color: #bf342d;
    font-style: normal;
  }

  .rereview-deck {
    color: rgb(var(--text-rgb) / 0.72);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.75;
    margin: 2rem 0 0 auto;
    max-width: 680px;
  }

  .episode {
    background: #fffdf7;
    color: var(--text);
    padding: clamp(4rem, 8vw, 7rem) 0 7rem;
  }

  .episode__shell {
    display: grid;
    gap: clamp(2rem, 5vw, 5.5rem);
    grid-template-columns: 155px minmax(0, 1fr);
  }

  .episode__shell + .episode__shell {
    border-top: 1px solid rgb(var(--text-rgb) / 0.18);
    margin-top: clamp(5rem, 10vw, 9rem);
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .episode__index {
    border-top: 3px solid #bf342d;
    color: rgb(var(--text-rgb) / 0.66);
    font-size: 0.76rem;
    line-height: 1.55;
    padding-top: 1rem;
  }

  .episode__index span {
    color: var(--text);
    display: block;
    font-family: Merriweather, Georgia, serif;
    font-size: 3.4rem;
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .episode__index p {
    margin: 0.35rem 0;
  }

  .episode__heading {
    max-width: 790px;
  }

  .episode__heading h2,
  .episode__afterword h2 {
    font-family: Merriweather, Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 4.35rem);
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
  }

  .episode__heading > p:last-child,
  .episode__afterword > p:not(.rereview-kicker, .episode__links) {
    color: rgb(var(--text-rgb) / 0.72);
    font-size: 1.04rem;
    line-height: 1.8;
    margin-top: 1.4rem;
    max-width: 68ch;
  }

  .episode__film {
    align-items: start;
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: minmax(260px, 390px) minmax(180px, 1fr);
    margin: 3.5rem 0 4.5rem;
  }

  .episode__film video {
    aspect-ratio: 9 / 16;
    background: #111a18;
    box-shadow: 1.2rem 1.4rem 0 rgb(20 40 36 / 0.12);
    display: block;
    height: auto;
    width: 100%;
  }

  .episode__film figcaption {
    border-top: 1px solid rgb(var(--text-rgb) / 0.2);
    color: rgb(var(--text-rgb) / 0.62);
    font-size: 0.82rem;
    line-height: 1.65;
    padding-top: 1rem;
  }

  .episode__grid {
    border-block: 1px solid rgb(var(--text-rgb) / 0.18);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 4.5rem;
  }

  .episode__grid > div {
    padding: 2.5rem 2.5rem 2.75rem 0;
  }

  .episode__grid > div + div {
    border-left: 1px solid rgb(var(--text-rgb) / 0.18);
    padding-left: 2.5rem;
  }

  .episode__grid h3 {
    font-family: Merriweather, Georgia, serif;
    font-size: 1.6rem;
    letter-spacing: 0;
    line-height: 1.28;
    margin: 0 0 1rem;
  }

  .episode__grid div > p:last-child {
    color: rgb(var(--text-rgb) / 0.7);
    line-height: 1.75;
  }

  blockquote {
    border-left: 5px solid #bf342d;
    margin: 0 0 5rem;
    padding: 0.4rem 0 0.4rem clamp(1.5rem, 4vw, 3rem);
  }

  blockquote p {
    font-family: Merriweather, Georgia, serif;
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: 0;
    line-height: 1.12;
    margin: 0;
    max-width: 17ch;
  }

  blockquote footer {
    color: rgb(var(--text-rgb) / 0.58);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-top: 1.4rem;
    text-transform: uppercase;
  }

  .episode__afterword {
    border-top: 1px solid rgb(var(--text-rgb) / 0.18);
    margin-top: clamp(5rem, 10vw, 9rem);
    max-width: 780px;
    padding-top: clamp(4rem, 8vw, 7rem);
  }

  .episode__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    margin-top: 2rem;
  }

  .episode__links a {
    border-bottom: 2px solid #bf342d;
    color: var(--text);
    font-size: 0.84rem;
    font-weight: 800;
    padding-bottom: 0.26rem;
    text-decoration: none;
  }

  .episode__links a:hover,
  .episode__links a:focus-visible {
    color: #a82d27;
  }

  .sr-only {
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (max-width: 760px) {
    .episode__shell {
      grid-template-columns: 1fr;
    }

    .episode__index {
      display: grid;
      gap: 0.4rem 1.2rem;
      grid-template-columns: auto 1fr;
    }

    .episode__index span {
      grid-row: 1 / span 3;
      margin: 0;
    }

    .episode__film {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .episode__film video {
      max-width: 370px;
    }

    .episode__grid {
      grid-template-columns: 1fr;
    }

    .episode__grid > div {
      padding: 2rem 0;
    }

    .episode__grid > div + div {
      border-left: 0;
      border-top: 1px solid rgb(var(--text-rgb) / 0.18);
      padding-left: 0;
    }
  }
</style>
