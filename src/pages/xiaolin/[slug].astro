---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl, siteRoot } from "../../lib/seo";

export async function getStaticPaths() {
  const entries = await getCollection("xiaolin", ({ data }) => data.public && !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const pagePath = `/xiaolin/${entry.id}/`;
const pageUrl = absoluteUrl(pagePath, Astro.site);
const rootUrl = siteRoot(Astro.site);
const description = entry.data.metaDescription ?? entry.data.subtitle;
const pageLanguage = entry.data.lang === "zh-TW" ? "zh-Hant" : "en";
const isCounterclaw = entry.data.resident === "counterclaw";
const counterclawData = "rivalAction" in entry.data ? entry.data : undefined;
const roomDate = new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Taipei" }).format(
  entry.data.date,
);
const residentName = isCounterclaw ? "Counterclaw / 對鉗" : "Xiaolin / 小林";
const structuredAuthor = isCounterclaw
  ? "Counterclaw (fictional creative agent)"
  : "Xiaolin (fictional character)";
const disclosure =
  entry.data.disclosure ??
  (isCounterclaw
    ? "An archived Counterclaw response from a fictional, limited-autonomy creative agent under editorial control."
    : "An archived Xiaolin note. It is not a statement by Ying-Fan Lin or a record of private events.");
const noteSchema = {
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  headline: entry.data.title,
  description,
  url: pageUrl,
  mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
  author: {
    "@type": "Person",
    name: structuredAuthor,
  },
  publisher: { "@id": `${rootUrl}/#website` },
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.updated.toISOString(),
  inLanguage: pageLanguage,
  about: entry.data.tags,
  keywords: entry.data.tags,
};
---

<BaseLayout
  title={`${residentName}: ${entry.data.title}`}
  description={description}
  current="xiaolin"
  pageClass="xiaolin-page"
  canonicalPath={pagePath}
  image={entry.data.artwork}
  schema={noteSchema}
  type="article"
  lang={pageLanguage}
>
  <article class:list={["shell", "xiaolin-entry", { "is-counterclaw": isCounterclaw }]} data-entry-resident={entry.data.resident}>
    <header class="xiaolin-entry-head">
      <p class="xiaolin-kicker">
        {residentName} · {counterclawData ? counterclawData.rivalAction : entry.data.format ?? entry.data.category}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="xiaolin-lede">{entry.data.subtitle}</p>
      <p class="xiaolin-entry-date">
        <time datetime={roomDate}>
          {roomDate}
        </time>
      </p>
    </header>

    {counterclawData && (
      <section class="xiaolin-opposition-meta" aria-labelledby="opposition-meta-title">
        <div>
          <p class="xiaolin-resident-label">Defined creative action</p>
          <h2 id="opposition-meta-title">{counterclawData.rivalAction}</h2>
        </div>
        <div class="xiaolin-tension">
          <strong>Unresolved tension</strong>
          <span>{counterclawData.tension}</span>
        </div>
        <a href={withBase(`/xiaolin/${counterclawData.targetEntry}/`)}>Read the Xiaolin work being challenged</a>
      </section>
    )}

    {entry.data.artwork && (
      <figure class:list={["xiaolin-entry-art", { "is-counterclaw": isCounterclaw }]}>
        <img
          src={withBase(entry.data.artwork)}
          alt={entry.data.artworkAlt ?? ""}
          width="1200"
          height="800"
        />
      </figure>
    )}

    <div class="xiaolin-entry-grid">
      <div class="article-body">
        <Content />
      </div>
      <aside class="xiaolin-entry-disclosure">
        <p class="xiaolin-note-meta">About this page</p>
        <p>{disclosure}</p>
        {entry.data.fictionalized && <p>Scenes or objects in this entry may be fictionalized.</p>}
        <a href={withBase("/xiaolin/")}>Back to the shared Xiaolin room</a>
      </aside>
    </div>
  </article>
</BaseLayout>
