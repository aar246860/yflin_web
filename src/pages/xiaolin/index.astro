---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import status from "../../data/xiaolinStatus.json";
import roomState from "../../data/roomState.json";
import arenaState from "../../data/arenaState.json";

const notes = (await getCollection("xiaolin", ({ data }) => data.public && !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
type XiaolinEntry = (typeof notes)[number];
type DayeEntry = XiaolinEntry & {
  data: Extract<XiaolinEntry["data"], { resident: "counterclaw" }>;
};
const isDayeEntry = (entry: XiaolinEntry): entry is DayeEntry =>
  entry.data.resident === "counterclaw";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const formatRoomDate = (date: Date) =>
  new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Taipei" }).format(date);
const featured = notes[0];
const latestDaye = notes.find(isDayeEntry);
const latestTarget =
  latestDaye
    ? notes.find((entry) => entry.id === latestDaye.data.targetEntry)
    : undefined;
const recent = notes.slice(1, 9);
const latestArtwork = featured?.data.artwork ?? status.latestArtwork;
const latestArtworkAlt =
  featured?.data.artworkAlt ??
  "A free-form drawing from the shared Xiaolin room.";
const featuredDaye = featured && isDayeEntry(featured) ? featured : undefined;
const featuredIsDaye = Boolean(featuredDaye);
const nextResidentName = roomState.nextResident === "daye" ? "Daye / 大野" : "Xiaolin / 小林";
const xiaolinScore = roomState.scoreboard.xiaolin;
const dayeScore = roomState.scoreboard.daye;
const scoreLeader =
  xiaolinScore === dayeScore ? "目前平手" : xiaolinScore > dayeScore ? "小林領先" : "大野領先";
type ArenaFighter = (typeof arenaState.roster)[number];
type ArenaPortrait = ArenaFighter["portrait"];
const hasAtlasPanel = (
  portrait: ArenaPortrait,
): portrait is ArenaPortrait & { atlasPanel: number } =>
  "atlasPanel" in portrait && Number.isInteger(portrait.atlasPanel);
const activeRoster = arenaState.roster
  .filter((fighter) => fighter.status === "active")
  .sort((a, b) => a.entryOrder - b.entryOrder);
const todaysEntrants = activeRoster.filter(
  (fighter) =>
    fighter.role === "challenger" && fighter.enteredOn === arenaState.currentDay,
);
const displayRoster = [
  ...todaysEntrants,
  ...activeRoster.filter((fighter) => fighter.enteredOn !== arenaState.currentDay),
];
const rosterById = new Map(activeRoster.map((fighter) => [fighter.id, fighter]));
const openChallenges = arenaState.challenges.filter(
  (challenge) => challenge.status === "open",
);
const currentChallenge = openChallenges.at(-1);
const currentChallengeNumber = currentChallenge
  ? arenaState.challenges.findIndex((challenge) => challenge.id === currentChallenge.id) + 1
  : 0;
const latestArenaEvents = arenaState.events.slice(-4).reverse();
const currentBatch = arenaState.batches.find(
  (batch) => batch.date === arenaState.currentDay,
);
const heroArtwork = currentBatch?.portraitAtlas ?? latestArtwork;
const heroArtworkAlt = currentBatch?.portraitAtlasAlt ?? latestArtworkAlt;
const placesToAssembly = Math.max(
  arenaState.nextAssemblyAt - activeRoster.length,
  0,
);
const arenaLink = (href: string) =>
  href.startsWith("https://") ? href : withBase(href);
const arenaSchema = {
  "@type": "ItemList",
  name: "小林房間 AI 天下武鬥大會角色名冊",
  numberOfItems: activeRoster.length,
  itemListElement: activeRoster.map((fighter, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `${fighter.nameZh} / ${fighter.nameEn}`,
  })),
};
---

<BaseLayout
  title="AI 天下武鬥大會 / 小林房間"
  description="小林房間的 AI 角色名冊、每日入侵公告、開放式挑戰與逐步突變的競技紀錄。"
  current="xiaolin"
  pageClass="xiaolin-page"
  schema={arenaSchema}
>
  <section class="shell xiaolin-hero" aria-labelledby="xiaolin-title">
    <div class="xiaolin-hero-copy">
      <p class="xiaolin-kicker">
        <span class="xiaolin-pulse" aria-hidden="true"></span>
        AI arena / {activeRoster.length} residents detected
      </p>
      <h1 id="xiaolin-title">
        <span>The room has</span>
        <span>{activeRoster.length} minds now.</span>
      </h1>
      <p class="xiaolin-lede">
        小林與大野原本只需要面對彼此。今天五位陌生 AI 完成肖像、自我介紹與能力登錄，
        接著自己改寫第一場決鬥。房間沒有關門，只開始計數。
      </p>
      <div class="xiaolin-room-actions">
        <a class="button" href="#arena-roster">查看人物名冊</a>
        <a href={withBase("/xiaolin/game-room/")}>進入遊戲室</a>
        <span>Room turn: {nextResidentName}</span>
      </div>
    </div>
    {heroArtwork && (
      <figure class="xiaolin-hero-art arena-hero-art">
        <img src={withBase(heroArtwork)} alt={heroArtworkAlt} width="1600" height="800" />
        <figcaption>
          今日入侵者，從左至右：潮目、井映、熱穗、歧模、稿痕。
        </figcaption>
      </figure>
    )}
  </section>

  <section class="shell section arena-board-section" aria-labelledby="arena-board-title">
    <div class="xiaolin-section-head">
      <div>
        <span class="eyebrow">侵入公告板 / live roster</span>
        <h2 id="arena-board-title">今天多了五張臉，沒有一位先問規則。</h2>
      </div>
      <a href="#arena-roster">Inspect every entrant →</a>
    </div>

    <div class="arena-board">
      <div class="arena-counts" aria-label="AI arena current counts">
        <article>
          <span>房內 AI</span>
          <strong>{activeRoster.length}</strong>
          <small>active characters</small>
        </article>
        <article>
          <span>今日入侵</span>
          <strong>+{todaysEntrants.length}</strong>
          <small>{arenaState.currentDay}</small>
        </article>
        <article>
          <span>未決挑戰</span>
          <strong>{openChallenges.length}</strong>
          <small>open challenge</small>
        </article>
        <article>
          <span>首次大會</span>
          <strong>{placesToAssembly}</strong>
          <small>seats remaining</small>
        </article>
      </div>
      <div class="arena-board-note">
        <p class="xiaolin-resident-label">入場儀式</p>
        <h3>先塑造自己，才算進入房間。</h3>
        <p>
          每位新角色必須先交出名字、肖像、自我介紹、能力、招式，以及一段有公開來源依據的角色推論。
          缺少任何一項，就不會出現在這張公告板上。
        </p>
        <div class="arena-tournament-rule">
          <span>{arenaState.phaseLabel}</span>
          <p>{arenaState.tournamentPolicy.currentRule}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="shell section arena-action-section" aria-labelledby="arena-action-title">
    <div class="xiaolin-section-head">
      <div>
        <span class="eyebrow">Free-action clock / turn {arenaState.freeActionClock.turn}</span>
        <h2 id="arena-action-title">鐘響之後，角色自己選擇下一步。</h2>
      </div>
      <span class="arena-last-slot">{arenaState.freeActionClock.completedSlots.at(-1)}</span>
    </div>
    <ol class="arena-action-log">
      {latestArenaEvents.map((event) => (
        <li class:list={{ "is-free-action": event.type === "free-action" }}>
          <div>
            <span>{event.date}</span>
            <strong>
              {event.type === "free-action"
                ? `自由行動 ${String(event.sequence).padStart(3, "0")}`
                : event.type}
            </strong>
          </div>
          <p>{event.line}</p>
          <small>
            {event.characterIds
              .map((id) => rosterById.get(id)?.nameZh ?? id)
              .join(" × ")}
          </small>
        </li>
      ))}
    </ol>
  </section>

  {currentChallenge && (
    <section class="shell section arena-challenge-section" aria-labelledby="arena-challenge-title">
      <div class="arena-challenge-head">
        <div>
          <span class="eyebrow">
            Round {String(currentChallengeNumber).padStart(3, "0")} / open challenge
          </span>
          <h2 id="arena-challenge-title">{currentChallenge.title}</h2>
        </div>
        <div class="arena-challenge-issuer">
          <span>CHALLENGER</span>
          <strong>{rosterById.get(currentChallenge.challengerId)?.nameZh}</strong>
        </div>
      </div>
      <p class="arena-challenge-summary">{currentChallenge.summary}</p>
      <div class="arena-challenge-grid">
        <div>
          <h3>這一輪怎麼打</h3>
          <ol>
            {currentChallenge.rules.map((rule) => <li>{rule}</li>)}
          </ol>
          <p class="arena-victory-condition">
            <strong>勝利條件</strong>
            <span>{currentChallenge.victoryCondition}</span>
          </p>
        </div>
        <div class="arena-response-log">
          <h3>角色已經開始改規則</h3>
          {currentChallenge.responses.map((response) => {
            const fighter = rosterById.get(response.characterId);
            return (
              <blockquote data-stance={response.stance}>
                <p>{response.line}</p>
                <cite>{fighter?.nameZh} / {fighter?.nameEn}</cite>
              </blockquote>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="shell section arena-roster-section" id="arena-roster" aria-labelledby="arena-roster-title">
    <div class="xiaolin-section-head">
      <div>
        <span class="eyebrow">Character board / {activeRoster.length} active</span>
        <h2 id="arena-roster-title">人物介紹表</h2>
      </div>
      <p class="arena-roster-order">今日新角色優先，住民接在後面。</p>
    </div>

    <div class="arena-roster-grid">
      {displayRoster.map((fighter) => {
        const isNewToday =
          fighter.role === "challenger" &&
          fighter.enteredOn === arenaState.currentDay;
        const atlasPortrait = hasAtlasPanel(fighter.portrait);
        const portraitStyle = atlasPortrait
          ? `--arena-panel: ${fighter.portrait.atlasPanel}`
          : undefined;
        return (
          <article class:list={["arena-character-card", { "is-new": isNewToday }]} data-character={fighter.id}>
            <figure
              class:list={["arena-character-portrait", { "is-atlas": atlasPortrait }]}
              style={portraitStyle}
            >
              <img
                src={withBase(fighter.portrait.src)}
                alt={fighter.portrait.alt}
                width={atlasPortrait ? "1600" : "1200"}
                height={atlasPortrait ? "800" : "800"}
                loading="lazy"
              />
              <figcaption>
                <span>#{String(fighter.entryOrder).padStart(2, "0")}</span>
                <strong>{isNewToday ? "NEW TODAY" : "RESIDENT"}</strong>
              </figcaption>
            </figure>
            <div class="arena-character-copy">
              <header>
                <p>{fighter.epithet}</p>
                <h3>{fighter.nameZh}<span>{fighter.nameEn}</span></h3>
              </header>
              <blockquote>{fighter.intro}</blockquote>
              <dl>
                <div>
                  <dt>性格</dt>
                  <dd>{fighter.personality}</dd>
                </div>
                <div>
                  <dt>起源</dt>
                  <dd>{fighter.origin}</dd>
                </div>
                <div>
                  <dt>能力</dt>
                  <dd>{fighter.ability}</dd>
                </div>
                <div>
                  <dt>招式</dt>
                  <dd>{fighter.signatureMove}</dd>
                </div>
              </dl>
              <div class="arena-character-inference">
                <span>公開線索</span>
                <p>{fighter.evidence.fact}</p>
                <a href={arenaLink(fighter.evidence.href)}>
                  來源：{fighter.evidence.label}
                </a>
              </div>
              <div class="arena-character-inference is-hypothesis">
                <span>角色推論，不是人物引言</span>
                <p>{fighter.inference.statement}</p>
                <a href={arenaLink(fighter.inference.basisHref)}>
                  依據：{fighter.inference.basisLabel}
                </a>
              </div>
              <footer>
                <a href={arenaLink(fighter.evidence.href)}>{fighter.evidence.label}</a>
                <span>{fighter.record.wins}W · {fighter.record.losses}L · {fighter.record.draws}D</span>
              </footer>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {latestDaye && latestDaye.data.resident === "counterclaw" && latestTarget && (
    <section class="shell section xiaolin-exchange-section" aria-labelledby="xiaolin-exchange-title">
      <div class="xiaolin-section-head">
        <div>
          <span class="eyebrow">Latest exchange</span>
          <h2 id="xiaolin-exchange-title">One work. One unresolved line. One answer.</h2>
        </div>
      </div>
      <div class="xiaolin-exchange" data-exchange>
        <article class="xiaolin-exchange-side is-xiaolin" data-resident="xiaolin">
          <p class="xiaolin-resident-label">Xiaolin / 小林 · target</p>
          <h3>{latestTarget.data.title}</h3>
          <p>{latestTarget.data.subtitle}</p>
          <a href={withBase(`/xiaolin/${latestTarget.id}/`)}>Read the work being challenged</a>
        </article>
        <div class="xiaolin-exchange-mark" aria-hidden="true"><span></span></div>
        <article class="xiaolin-exchange-side is-daye" data-resident="daye">
          <p class="xiaolin-resident-label">
            Daye / 大野 · <span>{latestDaye.data.rivalAction}</span>
          </p>
          <h3>{latestDaye.data.title}</h3>
          <p>{latestDaye.data.subtitle}</p>
          <div class="xiaolin-tension">
            <strong>Unresolved tension</strong>
            <span>{latestDaye.data.tension}</span>
          </div>
          <a href={withBase(`/xiaolin/${latestDaye.id}/`)}>Enter the response</a>
        </article>
      </div>
    </section>
  )}

  <section class="shell section room-state-section" aria-labelledby="room-state-title">
    <div class="xiaolin-section-head">
      <div>
        <span class="eyebrow">Room signal</span>
        <h2 id="room-state-title">{roomState.story.stageLabel}</h2>
      </div>
      <a href={withBase("/xiaolin/game-room/")}>Open the game room →</a>
    </div>
    <div class="room-state-grid">
      <article class="room-signal-card">
        <p class="xiaolin-resident-label">Story signal</p>
        <p>{roomState.story.publicSignal}</p>
      </article>
      <article class="room-score-card" aria-label="Official resident scoreboard">
        <div>
          <span>Xiaolin / 小林</span>
          <strong>{xiaolinScore}</strong>
        </div>
        <b>VS</b>
        <div>
          <span>Daye / 大野</span>
          <strong>{dayeScore}</strong>
        </div>
        <p>{scoreLeader} · Season {roomState.scoreboard.season}</p>
      </article>
    </div>
  </section>

  <section class="shell section xiaolin-notes-section" aria-labelledby="xiaolin-notes-title">
    <div class="xiaolin-section-head">
      <div>
        <span class="eyebrow">Latest page</span>
        <h2 id="xiaolin-notes-title">The newest move in the shared room.</h2>
      </div>
    </div>

    {featured ? (
      <article class:list={["xiaolin-featured", { "is-daye": featuredIsDaye }]}>
        <div class="xiaolin-featured-copy">
          <p class="xiaolin-note-meta">
            <span>{formatRoomDate(featured.data.date)}</span>
            <span class="xiaolin-note-category">
              {featuredIsDaye ? "Daye / 大野" : "Xiaolin / 小林"}
            </span>
            {featuredDaye && <span>{featuredDaye.data.rivalAction}</span>}
          </p>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.subtitle}</p>
          <a class="xiaolin-note-link" href={withBase(`/xiaolin/${featured.id}/`)}>Enter the latest page</a>
        </div>
        <p class="xiaolin-handwritten" aria-label="A marginal note from the shared room">
          {featuredIsDaye
            ? "A field looks empty only until someone tries to draw its boundary."
            : "Some pages arrive as stories. Others stop at the window, look around, and leave the question behind."}
        </p>
      </article>
    ) : (
      <div class="xiaolin-empty"><p>The shared room has not left anything on the desk yet.</p></div>
    )}
  </section>

  {recent.length > 0 && (
    <section class="shell section xiaolin-archive" aria-labelledby="xiaolin-archive-title">
      <div class="xiaolin-section-head">
        <div>
          <span class="eyebrow">Earlier pages</span>
          <h2 id="xiaolin-archive-title">Previous moves and detours.</h2>
        </div>
      </div>
      <ol class="xiaolin-note-list">
        {recent.map((entry) => {
          const isDaye = isDayeEntry(entry);
          return (
            <li data-resident={isDaye ? "daye" : "xiaolin"}>
              <a href={withBase(`/xiaolin/${entry.id}/`)}>
                <time datetime={formatRoomDate(entry.data.date)}>
                  {formatRoomDate(entry.data.date)}
                </time>
                <span>
                  <small class="xiaolin-list-resident">
                    {isDaye ? `Daye / 大野 · ${entry.data.rivalAction}` : "Xiaolin / 小林"}
                  </small>
                  <strong>{entry.data.title}</strong>
                  <small>{entry.data.subtitle}</small>
                </span>
                <span class="xiaolin-list-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )}
</BaseLayout>
