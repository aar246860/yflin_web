---
import TeamActivity from "../../components/team/TeamActivity.astro";
import TeamClosing from "../../components/team/TeamClosing.astro";
import TeamDirection from "../../components/team/TeamDirection.astro";
import TeamGraduates from "../../components/team/TeamGraduates.astro";
import TeamHero from "../../components/team/TeamHero.astro";
import TeamPublications from "../../components/team/TeamPublications.astro";
import { activityPhotos } from "../../data/groupSite";
import members from "../../data/members.generated.json";
import { teamPublicationHighlights } from "../../data/teamShowcase";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/team-shared.css";
import "../../styles/team-hero.css";
import "../../styles/team-direction.css";
import "../../styles/team-graduates.css";
import "../../styles/team-publications.css";
import "../../styles/team-activity.css";
import "../../styles/team-closing.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const principalInvestigator = members.currentMembers[0];
const graduates = members.alumniMembers;
const thesisGraduates = graduates.slice(0, 2);
const researchContributors = graduates.slice(2);
const groupSchema = {
  "@type": "ResearchOrganization",
  name: "Lin Groundwater Hydraulics Group",
  url: new URL(withBase("/team/"), Astro.site),
  founder: {
    "@type": "Person",
    name: principalInvestigator.name.en,
  },
  member: [...members.currentMembers, ...graduates].map((member) => ({
    "@type": "Person",
    name: member.name.en,
  })),
};
---

<BaseLayout
  title="People and Research Outcomes"
  description="Graduate research, student-involved publications, and group activity in the Lin Groundwater Hydraulics Group."
  current="team"
  canonicalPath="/team/"
  image="/media/team-life/jpgu-2026/jpgu-2026-team-selfie.jpg"
  schema={groupSchema}
  pageClass="team-showcase-page"
>
  <TeamHero graduatesCount={graduates.length} publicationCount={teamPublicationHighlights.length} />
  <TeamDirection {principalInvestigator} />
  <TeamGraduates {thesisGraduates} {researchContributors} />
  <TeamPublications publications={teamPublicationHighlights} />
  <TeamActivity photos={activityPhotos} />
  <TeamClosing />
</BaseLayout>
