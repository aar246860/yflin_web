---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import CollaborationCTA from "../../components/CollaborationCTA.astro";
import LaggingPumpingTestDemo from "../../components/research/LaggingPumpingTestDemo.astro";
import ScientificScrollStory from "../../components/research/ScientificScrollStory.astro";
import TransformationUncertaintyDemo from "../../components/research/TransformationUncertaintyDemo.astro";
import { absoluteUrl, siteRoot } from "../../lib/seo";

export async function getStaticPaths() {
  const entries = await getCollection("concepts", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const rootUrl = siteRoot(Astro.site);
const pagePath = `/concepts/${entry.id}/`;
const pageUrl = absoluteUrl(pagePath, Astro.site);
const description = entry.data.metaDescription ?? entry.data.subtitle;
const conceptSchema = [
  {
    "@type": "DefinedTerm",
    "@id": `${pageUrl}#defined-term`,
    name: entry.data.title,
    description,
    url: pageUrl,
    inDefinedTermSet: absoluteUrl("/concepts/", Astro.site),
    keywords: entry.data.tags,
  },
  {
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    headline: entry.data.title,
    description,
    url: pageUrl,
    mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
    author: { "@id": `${rootUrl}/#person` },
    datePublished: entry.data.date.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    about: { "@id": `${pageUrl}#defined-term` },
    keywords: entry.data.tags,
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={description}
  current="concepts"
  canonicalPath={pagePath}
  schema={conceptSchema}
  type="article"
>
  <article class:list={["article", { "lagging-concept": entry.id === "lagging-theory" }]}>
    <header>
      <div class="tag-row">
        <EvidenceBadge level={entry.data.evidenceLevel} />
        {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.subtitle}</p>
    </header>
    {entry.id === "lagging-theory" && (
      <nav class="lagging-reading-paths" aria-label="Lagging Theory reading paths">
        <a href="#model-idea"><span>01 · 60 seconds</span><strong>Physical meaning and Darcy limit</strong></a>
        <a href="#published-cases"><span>02 · Published cases</span><strong>Evidence and its limits</strong></a>
        <a href="#lagging-pumping-demo"><span>03 · Teaching calculation</span><strong>Try the pumping demo</strong></a>
        <p>For field interpretation, start with the <a href="#minimum-tests">technical validation checklist</a>.</p>
      </nav>
    )}
    <div class="article-body">
      <Content />
    </div>
  </article>
  {entry.id === "lagging-theory" && <LaggingPumpingTestDemo />}
  {entry.id === "transformation-uncertainty" && <ScientificScrollStory />}
  {entry.id === "transformation-uncertainty" && <TransformationUncertaintyDemo />}
  <CollaborationCTA />
</BaseLayout>

<style>
  .lagging-concept :global(.article-body a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .lagging-reading-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }
  .lagging-reading-paths > a {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
  }
  .lagging-reading-paths > a:hover,
  .lagging-reading-paths > a:focus-visible {
    text-decoration: underline;
  }
  .lagging-reading-paths span { font-size: 0.875rem; }
  .lagging-reading-paths strong { font-weight: 600; }
  .lagging-reading-paths p { grid-column: 1 / -1; margin: 0; }
  .lagging-reading-paths p a { text-decoration: underline; }
  @media (max-width: 640px) {
    .lagging-reading-paths { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
