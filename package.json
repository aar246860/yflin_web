{
  "name": "yflin_web_astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "motion:assets": "node scripts/generate_motion_assets.mjs",
    "content:sync": "node scripts/import_publications.mjs",
    "content:report": "node scripts/content_report.mjs",
    "copy:review": "node scripts/copy_tone_report.mjs",
    "visibility:report": "node scripts/visibility_report.mjs",
    "visibility:report:dry-run": "node scripts/visibility_report.mjs --dry-run",
    "visibility:pulse": "node scripts/daily_pulse.mjs",
    "visibility:pulse:gate": "node scripts/daily_pulse_gate.mjs",
    "tracking:gate": "node scripts/tracking_gate.mjs",
    "research-visibility-os:gate": "node scripts/research_visibility_os_gate.mjs",
    "answerability:gate": "node scripts/answerability_gate.mjs",
    "lint:prose": "node scripts/lint_prose.mjs",
    "evidence:gate": "node scripts/evidence_gate.mjs",
    "publication:gate": "node scripts/publication_gate.mjs",
    "video:gate": "node scripts/video_companion_gate.mjs",
    "video:verify:2025-10-6": "node scripts/verify_rethinking_aquifer_video.mjs",
    "predev": "node scripts/generate_motion_assets.mjs && node scripts/import_publications.mjs",
    "dev": "node scripts/run-astro.mjs dev",
    "prebuild": "node scripts/generate_motion_assets.mjs && node scripts/import_publications.mjs && node scripts/publication_gate.mjs && node scripts/video_companion_gate.mjs && node scripts/verify_rethinking_aquifer_video.mjs && node scripts/evidence_gate.mjs && node scripts/lint_prose.mjs && node scripts/xiaolin-publisher.mjs && node scripts/counterclaw-publisher.mjs && node scripts/room-publisher.mjs && node scripts/arena-publisher.mjs && node scripts/collective-publisher.mjs",
    "build": "node scripts/run-astro.mjs build && pagefind --site dist",
    "indexnow": "node scripts/submit_indexnow.mjs",
    "indexnow:dry-run": "node scripts/submit_indexnow.mjs --dry-run",
    "distribution:pack": "node scripts/generate_distribution_pack.mjs",
    "distribution:pack:all": "node scripts/generate_distribution_pack.mjs --all",
    "xiaolin:check": "node scripts/xiaolin-publisher.mjs",
    "counterclaw:check": "node scripts/counterclaw-publisher.mjs",
    "room:check": "node scripts/room-publisher.mjs",
    "arena:check": "node scripts/arena-publisher.mjs",
    "collective:check": "node scripts/collective-publisher.mjs",
    "room:match": "node scripts/room-match.mjs",
    "test:counterclaw:unit": "node --test tests/counterclaw-lock.test.mjs tests/counterclaw-publisher.test.mjs tests/counterclaw-validator.test.mjs tests/room-publisher.test.mjs",
    "test:arena:unit": "node --test tests/arena-publisher.test.mjs",
    "test:collective:unit": "node --test tests/collective-publisher.test.mjs",
    "test:counterclaw:pages": "playwright test tests/counterclaw-pages.test.mjs",
    "test:collective:pages": "playwright test --config playwright.collective.config.mjs",
    "test:game:unit": "node --test tests/game/pumping-gameplay.test.mjs tests/game/pumping-physics.test.mjs tests/game/pumping-runtime.test.mjs tests/game/pumping-state.test.mjs",
    "typecheck:game": "node scripts/run-astro.mjs check --tsconfig tsconfig.counterclaw.json --minimumSeverity error && node scripts/check-pumping-game.mjs",
    "test:game:e2e": "node scripts/check-pumping-game.mjs --dist && playwright test --config playwright.game.config.mjs",
    "typecheck": "node scripts/run-astro.mjs check --tsconfig tsconfig.counterclaw.json --minimumSeverity error",
    "preview": "node scripts/run-astro.mjs preview",
    "astro": "node scripts/run-astro.mjs"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "^0.74.0",
    "@rive-app/canvas": "^2.38.1",
    "@tabler/icons": "^3.44.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.6",
    "gsap": "^3.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.0",
    "@sparticuz/chromium": "149.0.0",
    "fflate": "^0.8.3",
    "pagefind": "^1.4.0",
    "typescript": "^6.0.3",
    "write-good": "^1.0.8"
  }
}
